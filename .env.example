# Copy to .env (never commit it) and load it with:  set -a; . ./.env; set +a

# Required for `serve`
PA_API_TOKEN=                 # >= 24 chars, e.g. output of: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PA_CALL_TO=                   # number to call, E.164, e.g. +4917...
PA_CALL_PIN=                  # >= 6 digits, asked before anything is said

# Provider: fake (default, places no call) or twilio
PA_PROVIDER=fake
PA_LANGUAGE=en                # en or de

# Twilio (only with PA_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                  # your Twilio number, E.164
PA_PUBLIC_URL=                # https URL that reaches this server's /twilio/ path

# Limits
PA_MAX_CALLS_PER_DAY=3
PA_MIN_CALL_INTERVAL_MIN=30
PA_QUIET_HOURS=               # e.g. 23-7, empty = none
PA_WAITING_ESCALATE_MIN=0     # call when a session waits for input this long, 0 = off

# Paths and network (defaults shown)
# PA_STATE_DIR=~/.local/state/personal-agent
# PA_STATUS_DIR=~/.local/state/personal-agent/sessions
# PA_BIND_HOST=127.0.0.1
# PA_PORT=8787
